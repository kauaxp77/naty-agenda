# Domínio que aponta para o IP da VPS (ex.: n8n.suaempresa.com.br ou naty.duckdns.org)
DOMINIO=n8n.suaempresa.com.br

# Chave que criptografa as credenciais salvas no n8n (Google, Groq, Telegram).
# Gere com:  openssl rand -hex 32
# GUARDE UMA CÓPIA FORA DO SERVIDOR. Se perder, todas as credenciais precisam ser refeitas.
N8N_ENCRYPTION_KEY=
